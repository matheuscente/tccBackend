// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String
  email     String
  password  String
  birthDate DateTime
  role      Role     @default(USER)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            Session[]
  courses             Course[]
  goals               Goal[]
  studySessions       StudySession[]
  passwordResetTokens PasswordResetToken[]
  questions           Question[]
  activities          Activity[]
  activityAttempts    ActivityAttempt[]
  notes               Note[]
  files               StoredFile[]
  tickets             Ticket[]
  ticketMessages      TicketMessage[]

  @@index([username])
  @@index([email])
  @@map("users")
}

model Session {
  id     String @id @default(uuid())
  userId String

  refreshToken String   @unique
  expiresAt    DateTime
  isValid      Boolean  @default(true)

  // token anterior aceito por alguns segundos após a rotação (abas simultâneas / requisição interrompida)
  previousRefreshToken String?
  rotatedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Course {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  modules       Module[]
  goals         Goal[]
  studySessions StudySession[]
  questions     Question[]
  activities    Activity[]
  notes         Note[]
  files         StoredFile[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("courses")
}

model Module {
  id          String    @id @default(uuid())
  courseId    String
  title       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  disciplines   Discipline[]
  goals         Goal[]
  studySessions StudySession[]
  questions     Question[]
  activities    Activity[]
  notes         Note[]
  files         StoredFile[]

  @@index([courseId])
  @@map("modules")
}

model Discipline {
  id          String    @id @default(uuid())
  moduleId    String
  title       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  goals         Goal[]
  studySessions StudySession[]
  questions     Question[]
  activities    Activity[]
  notes         Note[]
  files         StoredFile[]

  @@index([moduleId])
  @@map("disciplines")
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  title         String
  type          GoalType
  targetMinutes Int
  startDate     DateTime
  endDate       DateTime?
  courseId      String?
  moduleId      String?
  disciplineId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module     Module?     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  discipline Discipline? @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([userId, title])
  @@index([userId])
  @@index([courseId])
  @@index([moduleId])
  @@index([disciplineId])
  @@map("goals")
}

model StudySession {
  id           String             @id @default(uuid())
  userId       String
  minutes      Int
  courseId     String?
  moduleId     String?
  disciplineId String?
  startedAt    DateTime
  status       StudySessionStatus
  studiedAt    DateTime
  createdAt    DateTime           @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module     Module?     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  discipline Discipline? @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("study_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Question {
  id           String       @id @default(uuid())
  userId       String
  statement    String
  type         QuestionType
  explanation  String?
  courseId     String?
  moduleId     String?
  disciplineId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module            Module?            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  discipline        Discipline?        @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  options           QuestionOption[]
  activityQuestions ActivityQuestion[]
  attemptAnswers    AttemptAnswer[]

  @@index([userId])
  @@index([courseId])
  @@index([moduleId])
  @@index([disciplineId])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int

  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptAnswers AttemptAnswer[]

  @@index([questionId])
  @@map("question_options")
}

model Activity {
  id           String    @id @default(uuid())
  userId       String
  title        String
  description  String?
  courseId     String?
  moduleId     String?
  disciplineId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module     Module?            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  discipline Discipline?        @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  questions  ActivityQuestion[]
  attempts   ActivityAttempt[]

  @@index([userId])
  @@map("activities")
}

model ActivityQuestion {
  activityId String
  questionId String
  order      Int

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([activityId, questionId])
  @@map("activity_questions")
}

model ActivityAttempt {
  id             String   @id @default(uuid())
  activityId     String
  userId         String
  correctCount   Int
  totalQuestions Int
  score          Float
  startedAt      DateTime
  finishedAt     DateTime @default(now())

  activity Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@index([activityId])
  @@index([userId])
  @@map("activity_attempts")
}

model AttemptAnswer {
  id               String  @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean

  attempt        ActivityAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([attemptId])
  @@map("attempt_answers")
}

model Note {
  id           String    @id @default(uuid())
  userId       String
  title        String
  content      String    @default("")
  courseId     String?
  moduleId     String?
  disciplineId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  module     Module?     @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  discipline Discipline? @relation(fields: [disciplineId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notes")
}

model StoredFile {
  id           String   @id @default(uuid())
  userId       String
  originalName String
  mimeType     String
  size         Int
  storageKey   String   @unique
  courseId     String?
  moduleId     String?
  disciplineId String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  module     Module?     @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  discipline Discipline? @relation(fields: [disciplineId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("files")
}

model Ticket {
  id        String         @id @default(uuid())
  userId    String
  subject   String
  category  TicketCategory
  status    TicketStatus   @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  closedAt  DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments TicketAttachment[]

  @@index([ticketId])
  @@map("ticket_messages")
}

model TicketAttachment {
  id           String   @id @default(uuid())
  messageId    String
  originalName String
  mimeType     String
  size         Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())

  message TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("ticket_attachments")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum TicketCategory {
  DOUBT
  PROBLEM
  SUGGESTION
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum GoalType {
  DAILY_ONCE
  DAILY_RECURRING
  TOTAL_BY_DATE
  TOTAL_IN_PERIOD
}

enum Role {
  ADMIN
  USER
}

enum StudySessionStatus {
  IN_PROGRESS
  COMPLETED
}
