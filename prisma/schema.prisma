// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String
  password  String
  birthDate DateTime
  role      Role     @default(USER)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  courses       Course[]
  goals         Goal[]
  studySessions StudySession[]

  @@index([username])
  @@map("users")
}

model Session {
  id     String @id @default(uuid())
  userId String

  refreshToken String   @unique
  expiresAt    DateTime
  isValid      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Course {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  modules       Module[]
  goals         Goal[]
  studySessions StudySession[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("courses")
}

model Module {
  id          String    @id @default(uuid())
  courseId    String
  title       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  disciplines   Discipline[]
  goals         Goal[]
  studySessions StudySession[]

  @@index([courseId])
  @@map("modules")
}

model Discipline {
  id          String    @id @default(uuid())
  moduleId    String
  title       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  goals         Goal[]
  studySessions StudySession[]

  @@index([moduleId])
  @@map("disciplines")
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  title         String
  type          GoalType
  targetMinutes Int
  startDate     DateTime
  endDate       DateTime?
  courseId      String?
  moduleId      String?
  disciplineId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module     Module?     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  discipline Discipline? @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([userId, title])
  @@index([userId])
  @@index([courseId])
  @@index([moduleId])
  @@index([disciplineId])
  @@map("goals")
}

model StudySession {
  id           String   @id @default(uuid())
  userId       String
  minutes      Int
  courseId     String?
  moduleId     String?
  disciplineId String?
  startedAt    DateTime
  status       StudySessionStatus
  studiedAt    DateTime
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module     Module?     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  discipline Discipline? @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("study_sessions")
}

enum GoalType {
  DAILY_ONCE
  DAILY_RECURRING
  TOTAL_BY_DATE
  TOTAL_IN_PERIOD
}

enum Role {
  ADMIN
  USER
}

enum StudySessionStatus {
  IN_PROGRESS
  COMPLETED
}
