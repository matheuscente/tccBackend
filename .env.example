DATABASE_URL=postgresql://admin:admin123@localhost:5432/tcc
PORT=3000
APP_TIMEZONE=America/Sao_Paulo
CORS_ORIGINS=http://localhost:5173

# Segredos (troque em produção)
JWT_SECRET=troque-este-segredo
FILE_TOKEN_SECRET=troque-este-tambem
COOKIE_SECURE=false

FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000/api/v1

# SMTP para "esqueci a senha" (opcional: sem SMTP_HOST o link aparece no console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Organizador de Estudos <no-reply@seudominio.com>"

# Armazenamento de arquivos
# Sem as variáveis B2_* os arquivos ficam em disco, na pasta STORAGE_LOCAL_DIR
STORAGE_LOCAL_DIR=uploads
MAX_FILE_SIZE_MB=100

# Backblaze B2 (API compatível com S3).
# Valores abaixo: simulador local (docker compose up -d ou npm run b2:local).
# Produção: B2_ENDPOINT=https://s3.<região>.backblazeb2.com, B2_REGION=<região>,
#           chaves geradas no painel do B2 e B2_FORCE_PATH_STYLE=false
B2_ENDPOINT=http://localhost:9000
B2_REGION=us-east-005
B2_BUCKET=organizador-estudos
B2_KEY_ID=local-key-id
B2_APPLICATION_KEY=local-application-key
B2_FORCE_PATH_STYLE=true

# Usuário administrador criado pelo seed (npm run seed)
ADMIN_NAME=ADMINISTRADOR
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@organizador.local
ADMIN_PASSWORD=Admin12345
